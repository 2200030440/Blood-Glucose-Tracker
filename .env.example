# ==============================================================================
# SWEETY — Environment Configuration Template
# ==============================================================================

# Database Connection (PostgreSQL)
# Locally: postgresql://<user>:<password>@localhost:5432/<database_name>
# On Railway: Automatically injected by Railway PostgreSQL service via ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sweety_db

# Application Environment & Port
NODE_ENV=development
PORT=5000

# JSON Web Token Secret (Provide a long, high-entropy random string in production)
JWT_SECRET=sweety_super_secret_jwt_key_min_32_characters_for_production_safety_2026
JWT_EXPIRES_IN=7d

# Session Cookie Secret
COOKIE_SECRET=sweety_cookie_security_secret_string_2026

# Client URL (For CORS during separate local development; in production Railway single-origin, this is optional)
CLIENT_URL=http://localhost:5173

# Optional: Set to true if evaluating locally without a running PostgreSQL daemon
USE_IN_MEMORY_DB=false
