{
  "name": "sweety-monorepo",
  "version": "1.0.0",
  "description": "SWEETY — Blood Glucose Tracker | Healthcare SaaS Web Application",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client && npm run prisma:generate --workspace=server",
    "start": "npm run start --workspace=server",
    "test": "npm run test --workspace=server",
    "test:client": "npm run test --workspace=client",
    "prisma:generate": "npm run prisma:generate --workspace=server",
    "prisma:migrate": "npm run prisma:migrate --workspace=server",
    "prisma:seed": "npm run prisma:seed --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

